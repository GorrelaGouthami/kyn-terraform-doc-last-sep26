#new by your project there is an + sign click on that it will allow you to create a file resource.tf extension should be tf. 
###we want to create an resource group using terrafrom. 
#we will open the terraform documentation copy the resource group code as it . 
#copy line number 8 till 11 and change my name to your name.
resource "azurerm_resource_group" "my-rg" {
  name     = "gopal-rg"
  location = "eastus"
}
#creat another file provider.tf copy line 13 till 25
terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "=5.0.0"
    }
  }
}

# Configure the Microsoft Azure Provider
provider "azurerm" {
  features {}
}

##once done click on ... at the visual studio code
#terminal-new terminal
terraform init
terraform validate
##finally do 
terraform plan
