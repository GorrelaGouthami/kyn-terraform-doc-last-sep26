#this will create the resource group serach for resource group in azure portal and you can see it
#lets create a new file vnet.tf #copy line 54 till 60
resource "azurerm_virtual_network" "vnet" {
  name                = "gopal-network"
  #this vnet need location and resource group
  location            = azurerm_resource_group.my-rg.location
  resource_group_name = azurerm_resource_group.my-rg.name
  address_space       = ["10.0.0.0/16"]
}

#create a new file public-subnet.tf copy line 63 till 68
resource "azurerm_subnet" "web-subnet" {
  name                 = "gopal-subnet"
  resource_group_name  =  azurerm_resource_group.my-rg.name
  virtual_network_name = azurerm_virtual_network.vnet.name
  address_prefixes     = ["10.0.1.0/24"]
}

#finally do 
terraform apply 
